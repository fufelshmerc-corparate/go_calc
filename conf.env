# Non-secret development defaults. Export JWT_SECRET separately (32+ bytes).
# Existing environment variables take precedence over these values.
HTTP_PORT=8080
GRPC_PORT=50051
DATABASE_PATH=data.db
COMPUTING_POWER=1
TIME_TIMEOUT_MS=100
TIME_ADDITION_MS=100
TIME_SUBTRACTION_MS=100
TIME_MULTIPLICATION_MS=100
TIME_DIVISION_MS=100
